    "import-assets": "python3 scripts/import_assets.py library && node scripts/build_packs.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.56.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.30.0"
  }
}
